# ----------------------------------------------------------------------
#   Project‑wide ignore rules – ROOT relative (leading slash optional)
# ----------------------------------------------------------------------

# Dependency directories
/node_modules/
/.pnp/
/.pnp.js

# Build output (Vite, CRA, etc.)
/dist/
/dist-ssr/
/build/

# Lock files – keep only one if you use it
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files (never commit secrets)
.env
.env.*
!.env.example   # keep a template if you want

# Logs & debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# OS‑specific files
.DS_Store
Thumbs.db

# Editor / IDE settings
/.vscode/*
!.vscode/extensions.json
/.idea/
/*.suo
/*.ntvs*
/*.njsproj
/*.sln
/*.sw?

